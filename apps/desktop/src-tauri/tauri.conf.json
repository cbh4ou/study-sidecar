{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Study Partner",
  "version": "0.1.0",
  "identifier": "dev.sidecar.study",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Study Partner",
        "width": 420,
        "height": 700,
        "alwaysOnTop": true,
        "transparent": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; media-src 'self' blob:; connect-src 'self' http://127.0.0.1:* http://localhost:* ws://127.0.0.1:* ws://localhost:*"
    }
  },
  "bundle": { "active": true }
}
